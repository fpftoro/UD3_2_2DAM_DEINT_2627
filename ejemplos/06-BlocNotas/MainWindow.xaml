<Window x:Class="BlocNotas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlocNotas"
        mc:Ignorable="d"
        Title="Sin título - Bloc de notas"
        Height="480"
        Width="720"
        Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"
                        Executed="Nuevo_Executed" />
        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Abrir_Executed" />
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Guardar_Executed"
                        CanExecute="Guardar_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo"
                          Command="ApplicationCommands.New" />
                <MenuItem Header="_Abrir…"
                          Command="ApplicationCommands.Open" />
                <MenuItem Header="_Guardar"
                          Command="ApplicationCommands.Save" />
                <Separator />
                <MenuItem x:Name="mnuSalir"
                          Header="_Salir"
                          InputGestureText="Alt+F4"
                          Click="mnuSalir_Click" />
            </MenuItem>
            <MenuItem Header="_Edición">
                <MenuItem Command="ApplicationCommands.Undo" />
                <Separator />
                <MenuItem Command="ApplicationCommands.Cut" />
                <MenuItem Command="ApplicationCommands.Copy" />
                <MenuItem Command="ApplicationCommands.Paste" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtPosicion"
                           Text="Línea 1, columna 1" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="txtCaracteres"
                           Text="0 caracteres" />
            </StatusBarItem>
        </StatusBar>

        <TextBox x:Name="txtContenido"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 TextChanged="txtContenido_TextChanged"
                 SelectionChanged="txtContenido_SelectionChanged"
                 PreviewKeyDown="txtContenido_PreviewKeyDown"
                 PreviewMouseWheel="txtContenido_PreviewMouseWheel" />
    </DockPanel>
</Window>
