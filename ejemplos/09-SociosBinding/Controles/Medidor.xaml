<UserControl x:Class="SociosBinding.Controles.Medidor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="200">
    <!-- Los bindings internos leen las propiedades del propio control -->
    <StackPanel>
        <TextBlock>
            <Run Text="{Binding Titulo, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Run Text="{Binding Valor, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Run Text="de" />
            <Run Text="{Binding Maximo, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </TextBlock>
        <ProgressBar Height="8"
                     Margin="0,4,0,0"
                     Maximum="{Binding Maximo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Value="{Binding Valor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </StackPanel>
</UserControl>
