<Window x:Class="SociosComandos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SociosComandos"
        xmlns:controles="clr-namespace:SociosComandos.Controles"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:SociosViewModel}"
        Title="Socios del club"
        Height="480"
        Width="760"
        MinHeight="400"
        MinWidth="640">
    <!-- Atajos de teclado que lanzan los mismos comandos que los botones -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N"
                    Command="{Binding NuevoCommand}" />
        <KeyBinding Gesture="Ctrl+E"
                    Command="{Binding ExportarCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding NumeroSocios, Mode=OneWay}" />
                    <Run Text="socios · Cuotas:" />
                    <Run Text="{Binding TotalCuotas, Mode=OneWay, StringFormat='{}{0:0.00} € al mes'}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Estado}" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="120"
                             Height="12"
                             Value="{Binding Progreso}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <!-- Propiedad de dependencia propia como destino de un binding -->
                <controles:Medidor Width="160"
                                   Titulo="Plazas:"
                                   Maximo="20"
                                   Valor="{Binding NumeroSocios}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16"
              ColumnDefinitions="*, 16, 280">
            <!-- Columna izquierda: buscador y lista -->
            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top"
                       Content="_Buscar:"
                       Target="{Binding ElementName=txtBuscar}" />
                <TextBox x:Name="txtBuscar"
                         DockPanel.Dock="Top"
                         Margin="0,0,0,8"
                         Text="{Binding Buscar, UpdateSourceTrigger=PropertyChanged}" />
                <ListBox ItemsSource="{Binding VistaSocios}"
                         SelectedItem="{Binding SocioSeleccionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:Socio">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Nombre}"
                                           FontWeight="SemiBold" />
                                <TextBlock Foreground="Gray">
                                    <Run Text="{Binding Categoria, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding Antiguedad, Mode=OneWay, StringFormat='{}{0} años'}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding Cuota, Mode=OneWay, StringFormat='{}{0:0.00} €'}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Columna derecha: formulario enlazado al socio elegido -->
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Bottom">
                    <!-- Command sustituye a Click; IsEnabled lo gestiona CanExecute -->
                    <Button Content="N_uevo"
                            ToolTip="Ctrl+N"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Command="{Binding NuevoCommand}" />
                    <Button Content="_Eliminar"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Command="{Binding EliminarCommand}" />
                    <Button Content="E_xportar"
                            ToolTip="Ctrl+E"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Command="{Binding ExportarCommand}" />
                    <Button Content="_Cancelar"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Command="{Binding CancelarExportacionCommand}" />
                </WrapPanel>

                <StackPanel DataContext="{Binding SocioSeleccionado}"
                            IsEnabled="{Binding DataContext.HaySeleccion, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="Ficha del socio"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Label Content="_Nombre:"
                           Target="{Binding ElementName=txtNombre}" />
                    <TextBox x:Name="txtNombre"
                             Margin="0,0,0,8"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="_Categoría:"
                           Target="{Binding ElementName=cmbCategoria}" />
                    <ComboBox x:Name="cmbCategoria"
                              Margin="0,0,0,8"
                              ItemsSource="{x:Static local:CalculadoraCuotas.Categorias}"
                              SelectedItem="{Binding Categoria}" />

                    <Label Content="_Antigüedad (años):"
                           Target="{Binding ElementName=txtAntiguedad}" />
                    <!-- Si lo escrito no es un número, el binding no lo pasa al socio y marca la caja en rojo -->
                    <TextBox x:Name="txtAntiguedad"
                             Margin="0,0,0,8"
                             Text="{Binding Antiguedad, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Cuota, StringFormat='Cuota: {0:0.00} € al mes'}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
