<Window x:Class="SociosCodeBehind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SociosCodeBehind"
        mc:Ignorable="d"
        Title="Socios del club"
        Height="480"
        Width="760"
        MinHeight="400"
        MinWidth="640"
        Closing="Window_Closing">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtResumen" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16"
              ColumnDefinitions="*, 16, 280">
            <!-- Columna izquierda: buscador y lista -->
            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top"
                       Content="_Buscar:"
                       Target="{Binding ElementName=txtBuscar}" />
                <TextBox x:Name="txtBuscar"
                         DockPanel.Dock="Top"
                         Margin="0,0,0,8"
                         TextChanged="txtBuscar_TextChanged" />
                <ListBox x:Name="lstSocios"
                         SelectionChanged="lstSocios_SelectionChanged" />
            </DockPanel>

            <!-- Columna derecha: formulario del socio -->
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="txtTituloFicha"
                           Text="Nuevo socio"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Label Content="_Nombre:"
                       Target="{Binding ElementName=txtNombre}" />
                <TextBox x:Name="txtNombre"
                         Margin="0,0,0,8"
                         TextChanged="Formulario_Changed" />

                <Label Content="_Categoría:"
                       Target="{Binding ElementName=cmbCategoria}" />
                <ComboBox x:Name="cmbCategoria"
                          SelectedIndex="1"
                          Margin="0,0,0,8"
                          SelectionChanged="Formulario_Changed">
                    <ComboBoxItem Content="Infantil" />
                    <ComboBoxItem Content="Adulto" />
                    <ComboBoxItem Content="Senior" />
                </ComboBox>

                <Label Content="_Antigüedad (años):"
                       Target="{Binding ElementName=txtAntiguedad}" />
                <TextBox x:Name="txtAntiguedad"
                         Text="0"
                         Margin="0,0,0,8"
                         TextChanged="Formulario_Changed" />

                <TextBlock x:Name="txtCuota"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <WrapPanel>
                    <Button x:Name="btnNuevo"
                            Content="N_uevo"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Click="btnNuevo_Click" />
                    <Button x:Name="btnGuardar"
                            Content="_Guardar"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Click="btnGuardar_Click" />
                    <Button x:Name="btnEliminar"
                            Content="_Eliminar"
                            MinWidth="72"
                            Margin="0,0,8,8"
                            Click="btnEliminar_Click" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
