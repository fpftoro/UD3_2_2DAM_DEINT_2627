<UserControl x:Class="Club.Wpf.Vistas.ResumenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Club.Nucleo.ViewModels;assembly=Club.Nucleo"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResumenViewModel}"
             d:DesignHeight="300"
             d:DesignWidth="500">
    <StackPanel>
        <TextBlock Text="Resumen por categorías"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />
        <DataGrid ItemsSource="{Binding Filas}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  HorizontalAlignment="Left">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Categoría"
                                    Binding="{Binding Categoria}" />
                <DataGridTextColumn Header="Socios"
                                    Binding="{Binding Socios}" />
                <DataGridTextColumn Header="Cuotas al mes"
                                    Binding="{Binding Cuotas, StringFormat='{}{0:0.00} €'}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock FontWeight="SemiBold"
                   Margin="0,16,0,0"
                   Text="{Binding Total, StringFormat='Total: {0:0.00} € al mes'}" />
    </StackPanel>
</UserControl>
