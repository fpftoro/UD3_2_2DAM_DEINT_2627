<UserControl x:Class="Club.Wpf.Vistas.SociosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Club.Nucleo.ViewModels;assembly=Club.Nucleo"
             xmlns:modelos="clr-namespace:Club.Nucleo.Modelos;assembly=Club.Nucleo"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SociosViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="640">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,8,0,0">
            <Run Text="{Binding NumeroSocios, Mode=OneWay}" />
            <Run Text="socios · Cuotas:" />
            <Run Text="{Binding TotalCuotas, Mode=OneWay, StringFormat='{}{0:0.00} € al mes'}" />
        </TextBlock>

        <Grid ColumnDefinitions="*, 16, 260">
            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top"
                       Content="_Buscar:"
                       Target="{Binding ElementName=txtBuscar}" />
                <TextBox x:Name="txtBuscar"
                         DockPanel.Dock="Top"
                         Text="{Binding Buscar, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="N_uevo"
                            MinWidth="72"
                            Margin="0,0,8,0"
                            Command="{Binding NuevoCommand}" />
                    <Button Content="_Eliminar"
                            MinWidth="72"
                            Command="{Binding EliminarCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding SociosVisibles}"
                         SelectedItem="{Binding SocioSeleccionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="modelos:Socio">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,2">
                                <!-- El convertidor elige el color según la categoría -->
                                <Ellipse Width="10"
                                         Height="10"
                                         Margin="0,0,8,0"
                                         Fill="{Binding Categoria, Converter={StaticResource CategoriaAColor}}" />
                                <TextBlock>
                                    <Run Text="{Binding Nombre, Mode=OneWay}"
                                         FontWeight="SemiBold" />
                                    <Run Text="{Binding Cuota, Mode=OneWay, StringFormat='· {0:0.00} €'}"
                                         Foreground="Gray" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- La ficha solo se ve si hay una abierta -->
            <StackPanel Grid.Column="2"
                        DataContext="{Binding Ficha}"
                        Visibility="{Binding DataContext.HayFicha, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock Text="{Binding Titulo}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Label Content="_Nombre:"
                       Target="{Binding ElementName=txtNombre}" />
                <TextBox x:Name="txtNombre"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="_Categoría:"
                       Target="{Binding ElementName=cmbCategoria}" />
                <ComboBox x:Name="cmbCategoria"
                          Margin="0,0,0,8"
                          ItemsSource="{Binding Categorias}"
                          SelectedItem="{Binding Categoria}" />

                <Label Content="_Antigüedad (años):"
                       Target="{Binding ElementName=txtAntiguedad}" />
                <TextBox x:Name="txtAntiguedad"
                         Text="{Binding AntiguedadTexto, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock FontWeight="SemiBold"
                           Margin="0,0,0,16"
                           Text="{Binding Cuota, StringFormat='Cuota: {0:0.00} € al mes', TargetNullValue='Cuota: —'}" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="_Guardar"
                            MinWidth="72"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Command="{Binding DataContext.GuardarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="Ca_ncelar"
                            MinWidth="72"
                            Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
