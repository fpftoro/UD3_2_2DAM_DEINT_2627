<Window x:Class="Club.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Club.Nucleo.ViewModels;assembly=Club.Nucleo"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PrincipalViewModel}"
        Title="Club Deportivo"
        Height="520"
        Width="820"
        MinHeight="420"
        MinWidth="680">
    <DockPanel>
        <Border DockPanel.Dock="Left"
                Background="#2E7D32"
                Padding="8">
            <StackPanel Width="120">
                <Button Content="_Socios"
                        Margin="0,0,0,8"
                        Command="{Binding IrASociosCommand}" />
                <Button Content="_Resumen"
                        Command="{Binding IrAResumenCommand}" />
            </StackPanel>
        </Border>

        <!-- El ContentControl muestra un ViewModel; el DataTemplate de App.xaml elige la vista -->
        <ContentControl Margin="16"
                        Content="{Binding VistaActual}" />
    </DockPanel>
</Window>
