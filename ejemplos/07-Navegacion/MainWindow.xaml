<Window x:Class="Navegacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Navegacion"
        mc:Ignorable="d"
        Title="Club Deportivo"
        Height="480"
        Width="720"
        MinHeight="400"
        MinWidth="600">
    <DockPanel>
        <!-- Menú lateral: cada botón cambia la página del Frame -->
        <Border DockPanel.Dock="Left"
                Background="#2E7D32"
                Padding="8">
            <StackPanel Width="140">
                <Button x:Name="btnInicio"
                        Content="_Inicio"
                        Margin="0,0,0,8"
                        Click="btnInicio_Click" />
                <Button x:Name="btnSocios"
                        Content="_Socios"
                        Margin="0,0,0,8"
                        Click="btnSocios_Click" />
                <Separator Margin="0,8" />
                <Button x:Name="btnAyuda"
                        Content="A_yuda"
                        ToolTip="Abre la ayuda en una ventana aparte, sin bloquear esta"
                        Margin="0,0,0,8"
                        Click="btnAyuda_Click" />
            </StackPanel>
        </Border>

        <!-- El Frame muestra una Page y guarda el historial (Atrás y Adelante) -->
        <Frame x:Name="frmContenido"
               Margin="16"
               NavigationUIVisibility="Visible" />
    </DockPanel>
</Window>
