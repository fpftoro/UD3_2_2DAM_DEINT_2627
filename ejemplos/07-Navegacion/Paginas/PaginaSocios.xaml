<Page x:Class="Navegacion.Paginas.PaginaSocios"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Socios">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Socios"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <Button x:Name="btnNuevo"
                    Content="_Nuevo socio…"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="btnNuevo_Click" />
            <Button x:Name="btnVerFicha"
                    Content="_Ver ficha"
                    Padding="12,4"
                    Click="btnVerFicha_Click" />
        </StackPanel>
        <ListBox x:Name="lstSocios"
                 MouseDoubleClick="lstSocios_MouseDoubleClick" />
    </DockPanel>
</Page>
