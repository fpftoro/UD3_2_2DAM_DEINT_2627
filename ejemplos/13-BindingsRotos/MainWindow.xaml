<Window x:Class="BindingsRotos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BindingsRotos"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        mc:Ignorable="d"
        Title="Bindings rotos (a propósito)"
        Height="520"
        Width="560">
    <!-- Cada «ERROR n» es un fallo puesto a propósito: búscalo con las herramientas del tema 13 -->
    <StackPanel Margin="16">
        <TextBlock Text="Nombre (ERROR 1):"
                   FontWeight="SemiBold" />
        <!-- ERROR 1: la propiedad se llama Nombre, no Nombr -->
        <TextBlock Text="{Binding Nombr}"
                   Margin="0,0,0,16" />

        <TextBlock Text="Volumen (ERROR 2):"
                   FontWeight="SemiBold" />
        <Slider x:Name="sldVolumen"
                Maximum="100"
                Value="40" />
        <!-- ERROR 2: el control se llama sldVolumen -->
        <TextBlock Text="{Binding Value, ElementName=sldVolumn}"
                   Margin="0,0,0,16" />

        <TextBlock Text="Antigüedad (ERROR 3): escribe «abc»"
                   FontWeight="SemiBold" />
        <!-- ERROR 3: «abc» no se puede convertir a int. Con TraceLevel=High, la ventana Salida
             muestra paso a paso qué hace este binding -->
        <TextBox Text="{Binding Antiguedad, UpdateSourceTrigger=PropertyChanged, diag:PresentationTraceSources.TraceLevel=High}" />
        <TextBlock Text="{Binding Cuota, StringFormat='Cuota: {0:0.00} €'}"
                   Margin="0,0,0,16" />

        <TextBlock Text="Visitas (ERROR 4): pulsa el botón"
                   FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,16">
            <Button x:Name="btnVisitar"
                    Content="_Visitar"
                    Margin="0,0,8,0"
                    Click="btnVisitar_Click" />
            <!-- ERROR 4: el texto no cambia. No hay error en la Salida: falta el aviso -->
            <TextBlock Text="{Binding Visitas}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Actividades (ERROR 5):"
                   FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding Actividades}"
                 Height="64"
                 Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="local:Actividad">
                    <!-- ERROR 5: dentro de la plantilla, el DataContext es cada Actividad, que no tiene Cuota -->
                    <TextBlock>
                        <Run Text="{Binding Nombre, Mode=OneWay}" />
                        <Run Text="{Binding Cuota, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Nombre editable (ERROR 6): escribe y mira el texto de debajo"
                   FontWeight="SemiBold" />
        <!-- ERROR 6: el valor solo pasa al ViewModel al salir de la caja (LostFocus) -->
        <TextBox Text="{Binding Nombre}" />
        <TextBlock Text="{Binding Nombre, StringFormat='En el ViewModel: {0}'}" />
    </StackPanel>
</Window>
