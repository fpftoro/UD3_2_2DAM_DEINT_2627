<Window x:Class="FichaSocio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FichaSocio"
        mc:Ignorable="d"
        Title="Ficha del socio"
        Height="300"
        Width="420"
        FontFamily="Segoe UI"
        FontSize="14">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static local:FichaClub.Nombre}"
                   FontSize="22"
                   FontWeight="Bold" />
        <Border Margin="0,8,0,0"
                Padding="12"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Socio: Lucía Pérez" />
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Cuota mensual: " />
                    <Run Text="35,00 €"
                         FontWeight="Bold" />
                </TextBlock>
                <Button Content="Editar"
                        Margin="0,12,0,0"
                        Padding="16,4"
                        HorizontalAlignment="Left">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#E3F2FD"
                                          Offset="0" />
                            <GradientStop Color="#90CAF9"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
