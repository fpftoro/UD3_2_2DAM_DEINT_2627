<Window x:Class="Club.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Club.Nucleo.ViewModels;assembly=Club.Nucleo"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ClubViewModel}"
        Title="Club Deportivo"
        Height="560"
        Width="960"
        MinHeight="460"
        MinWidth="820">
    <TabControl Margin="8">
        <!-- Pestaña 1: maestro (socios) y detalle (ficha y actividades del socio) -->
        <TabItem Header="_Socios">
            <Grid Margin="8"
                  ColumnDefinitions="*, 16, 240, 16, 260">
                <!-- Maestro -->
                <DockPanel Grid.Column="0">
                    <Label DockPanel.Dock="Top"
                           Content="_Buscar:"
                           Target="{Binding ElementName=txtBuscar}" />
                    <TextBox x:Name="txtBuscar"
                             DockPanel.Dock="Top"
                             Text="{Binding Buscar, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Button Content="N_uevo"
                                MinWidth="72"
                                Margin="0,0,8,0"
                                Command="{Binding NuevoCommand}" />
                        <Button Content="_Eliminar"
                                MinWidth="72"
                                Command="{Binding EliminarCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Socios}"
                             SelectedItem="{Binding SocioSeleccionado}"
                             DisplayMemberPath="Nombre" />
                </DockPanel>

                <!-- Detalle 1: ficha del socio (alta y edición) -->
                <StackPanel Grid.Column="2"
                            DataContext="{Binding Ficha}"
                            Visibility="{Binding DataContext.HayFicha, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolAVisibilidad}}">
                    <TextBlock Text="{Binding Titulo}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Label Content="_Nombre:"
                           Target="{Binding ElementName=txtNombre}" />
                    <TextBox x:Name="txtNombre"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="_Categoría:"
                           Target="{Binding ElementName=cmbCategoria}" />
                    <ComboBox x:Name="cmbCategoria"
                              Margin="0,0,0,8"
                              ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding Categoria}" />
                    <Label Content="_Antigüedad (años):"
                           Target="{Binding ElementName=txtAntiguedad}" />
                    <TextBox x:Name="txtAntiguedad"
                             Text="{Binding AntiguedadTexto, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontWeight="SemiBold"
                               Margin="0,0,0,16"
                               Text="{Binding Cuota, StringFormat='Cuota: {0:0.00} € al mes', TargetNullValue='Cuota: —'}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="_Guardar"
                                MinWidth="72"
                                Margin="0,0,8,0"
                                IsDefault="True"
                                Command="{Binding DataContext.GuardarCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Ca_ncelar"
                                MinWidth="72"
                                Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Detalle 2: actividades del socio (relación varios a varios) -->
                <DockPanel Grid.Column="4">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Actividades del socio"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="_Dar de baja"
                                HorizontalAlignment="Left"
                                MinWidth="72"
                                Margin="0,8,0,16"
                                Command="{Binding DarDeBajaCommand}" />
                        <Label Content="Ac_tividad:"
                               Target="{Binding ElementName=cmbActividad}" />
                        <ComboBox x:Name="cmbActividad"
                                  Margin="0,0,0,8"
                                  ItemsSource="{Binding ActividadesDisponibles}"
                                  SelectedItem="{Binding ActividadParaInscribir}"
                                  DisplayMemberPath="Nombre" />
                        <Button Content="_Inscribir"
                                HorizontalAlignment="Left"
                                MinWidth="72"
                                Command="{Binding InscribirCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ActividadesDelSocio}"
                             SelectedItem="{Binding ActividadDelSocio}"
                             DisplayMemberPath="Nombre" />
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- Pestaña 2: actividades con sus inscritos (consulta con LEFT JOIN y GROUP BY) -->
        <TabItem Header="_Actividades">
            <DataGrid Margin="8"
                      ItemsSource="{Binding Actividades}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      HorizontalAlignment="Left">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Actividad"
                                        Binding="{Binding Nombre}" />
                    <DataGridTextColumn Header="Plazas"
                                        Binding="{Binding Plazas}" />
                    <DataGridTextColumn Header="Inscritos"
                                        Binding="{Binding Inscritos}" />
                    <DataGridTextColumn Header="Libres"
                                        Binding="{Binding PlazasLibres}" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
    </TabControl>
</Window>
