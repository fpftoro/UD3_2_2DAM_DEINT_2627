<Window x:Class="AltaSocio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AltaSocio"
        mc:Ignorable="d"
        Title="Alta de socio"
        Height="360"
        Width="520"
        MinHeight="320"
        MinWidth="420">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Alta de socio"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Sintaxis corta de .NET 10: una lista separada por comas en lugar de una etiqueta por fila -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto, *"
              RowDefinitions="Auto, Auto, Auto, *">
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Nombre:"
                       VerticalAlignment="Center"
                       Margin="0,0,16,8" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,0,8" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Correo:"
                       VerticalAlignment="Center"
                       Margin="0,0,16,8" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,0,0,8" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Categoría:"
                       VerticalAlignment="Center"
                       Margin="0,0,16,8" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      HorizontalAlignment="Left"
                      MinWidth="160"
                      SelectedIndex="1"
                      Margin="0,0,0,8">
                <ComboBoxItem Content="Infantil" />
                <ComboBoxItem Content="Adulto" />
                <ComboBoxItem Content="Senior" />
            </ComboBox>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Notas:"
                       Margin="0,0,16,8" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,8" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Cancelar"
                    Padding="16,4"
                    Margin="0,0,8,0" />
            <Button Content="Guardar"
                    Padding="16,4"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
