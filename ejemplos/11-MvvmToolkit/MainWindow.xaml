<Window x:Class="MvvmToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MvvmToolkit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:PrincipalViewModel}"
        Title="Socios con el CommunityToolkit.Mvvm"
        Height="480"
        Width="760">
    <DockPanel Margin="16">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Socios.Estado}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Registro de actividad a la derecha -->
        <GroupBox DockPanel.Dock="Right"
                  Header="Registro"
                  Width="240"
                  Margin="16,0,0,0">
            <ListBox ItemsSource="{Binding Registro.Entradas}" />
        </GroupBox>

        <DockPanel DataContext="{Binding Socios}">
            <WrapPanel DockPanel.Dock="Bottom"
                       Margin="0,8,0,0">
                <Button Content="N_uevo"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Command="{Binding NuevoCommand}" />
                <Button Content="_Eliminar"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Command="{Binding EliminarCommand}" />
                <Button Content="E_xportar"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Command="{Binding ExportarCommand}" />
                <Button Content="_Cancelar"
                        MinWidth="72"
                        Command="{Binding ExportarCancelCommand}" />
            </WrapPanel>

            <StackPanel DockPanel.Dock="Right"
                        Width="220"
                        Margin="16,0,0,0"
                        DataContext="{Binding SocioSeleccionado}">
                <Label Content="_Nombre:"
                       Target="{Binding ElementName=txtNombre}" />
                <TextBox x:Name="txtNombre"
                         Margin="0,0,0,8"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                <Label Content="_Categoría:"
                       Target="{Binding ElementName=cmbCategoria}" />
                <ComboBox x:Name="cmbCategoria"
                          Margin="0,0,0,8"
                          ItemsSource="{Binding DataContext.Socios.Categorias, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Categoria}" />
                <Label Content="_Antigüedad (años):"
                       Target="{Binding ElementName=txtAntiguedad}" />
                <TextBox x:Name="txtAntiguedad"
                         Margin="0,0,0,8"
                         Text="{Binding Antiguedad, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding Cuota, StringFormat='Cuota: {0:0.00} € al mes'}" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Socios}"
                     SelectedItem="{Binding SocioSeleccionado}"
                     DisplayMemberPath="Nombre" />
        </DockPanel>
    </DockPanel>
</Window>
